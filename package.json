{
  "name": "lantext",
  "version": "3.0.0",
  "description": "A local area network chat application for WiFi devices",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "lantext": "./dist/bin.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "gen:version": "node scripts/generate-version.mjs",
    "prebuild": "npm run gen:version",
    "pretypecheck": "npm run gen:version",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "prepack": "npm run build",
    "start": "node --experimental-ffi --disable-warning=ExperimentalWarning dist/main.js",
    "client": "node --experimental-ffi --disable-warning=ExperimentalWarning dist/main.js client",
    "host": "node --experimental-ffi --disable-warning=ExperimentalWarning dist/main.js host",
    "dev": "npm run build && DEBUG=true node --experimental-ffi --disable-warning=ExperimentalWarning dist/main.js"
  },
  "keywords": [
    "chat",
    "lan",
    "network",
    "wifi",
    "cli",
    "terminal"
  ],
  "author": "Victozee26",
  "license": "MIT",
  "engines": {
    "node": ">=26.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victozee26/LanText.git"
  },
  "bugs": {
    "url": "https://github.com/Victozee26/LanText/issues"
  },
  "homepage": "https://github.com/Victozee26/LanText#readme",
  "preferGlobal": true,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "typescript": "^7.0.2"
  }
}
