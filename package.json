{
  "name": "lantext",
  "version": "2.1.0",
  "description": "A local area network chat application for WiFi devices",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "lantext": "./dist/main.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "start": "node dist/main.js",
    "client": "node dist/client.js",
    "hotspot": "node dist/hotspot.js",
    "dev": "npm run build && DEBUG=true node dist/main.js"
  },
  "keywords": [
    "chat",
    "lan",
    "network",
    "wifi",
    "cli",
    "terminal"
  ],
  "author": "Victozee26",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victozee26/LanText.git"
  },
  "bugs": {
    "url": "https://github.com/Victozee26/LanText/issues"
  },
  "homepage": "https://github.com/Victozee26/LanText#readme",
  "preferGlobal": true,
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "ora": "^9.3.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
